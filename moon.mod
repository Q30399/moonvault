name = "Q30399/moonvault"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/Q30399/moonvault"

license = "Apache-2.0"

keywords = ["crypto", "password", "hash", "security", "bcrypt", "scrypt", "argon2", "sha256"]

preferred_target = "wasm"

description = "MoonVault -- Pure MoonBit password hashing and cryptographic library"
